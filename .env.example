# Public site URL used for metadata, sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify Storefront API. Leave blank to use the included mock products.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Social profiles. TikTok is already known; replace the others when created.
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@marnimarnni
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_SNAPCHAT_URL=

# Newsletter provider endpoint or API integration can be added later.
NEWSLETTER_PROVIDER=

# Analytics identifiers. Add only after consent and privacy configuration.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
